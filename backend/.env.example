# ---------------------------------------------------------------
# Outbound email (SMTP)
#
# Used for the credential emails sent when a Super Admin approves a
# business, rider or sorter. Leave blank to disable sending: accounts
# are still created, the request is marked email FAILED, and the Super
# Admin can resend from the request list once SMTP is configured.
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to "<COMPANY_LEGAL_NAME> <COMPANY_EMAIL>".
SMTP_FROM=

# How far from a pickup point a rider can be and still be offered the job,
# in metres. Defaults to 7000. Raise it for testing from another city.
RIDER_OFFER_RADIUS_M=7000

# How long a rider has to answer an offer, in seconds. Default 90.
RIDER_OFFER_TTL_SECONDS=90

# How old a rider position may be and still be dispatched to, in minutes.
# Default 15.
RIDER_STALE_FIX_MINUTES=15

# --- Processing facility ---
