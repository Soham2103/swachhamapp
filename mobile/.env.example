# Fallback backend URL, used only when Metro's host cannot be read (e.g. a
# production build). In dev, src/constants/api.ts resolves the backend from the
# LAN address Metro is already serving on, so this does not need editing when
# the network changes.
#
# 10.0.2.2 is the Android emulator's alias for the host machine.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000

# Do NOT set REACT_NATIVE_PACKAGER_HOSTNAME. Pinning an IP here breaks the app
# every time the laptop's Wi-Fi IP changes.

# --- TESTING ONLY ---
# Set to true to skip the Ratnagiri service-area check on the Allow Permissions
# screen, so sign-in can be tested from outside the district. Only takes effect
# in a dev build (__DEV__); a production build ignores it entirely.
# Leave unset/false for normal use.
EXPO_PUBLIC_DISABLE_LOCATION_GATE=false

# --- TESTING ONLY ---
# Report a fixed rider position instead of real GPS, so dispatch can be tested
# from a phone that is not in the service area. Leave blank for normal use.
# Only takes effect in a dev build (__DEV__).
EXPO_PUBLIC_RIDER_MOCK_LAT=
EXPO_PUBLIC_RIDER_MOCK_LNG=
