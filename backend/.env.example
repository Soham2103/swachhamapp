# ---------------------------------------------------------------
# Outbound email (SMTP)
#
# Used for the credential emails sent when a Super Admin approves a
# business, rider or sorter. Leave blank to disable sending: accounts
# are still created, the request is marked email FAILED, and the Super
# Admin can resend from the request list once SMTP is configured.
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to "<COMPANY_LEGAL_NAME> <COMPANY_EMAIL>".
SMTP_FROM=
