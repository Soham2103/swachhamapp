# Environment Variables — Swachham Backend

# MySQL Database (Aiven)
DATABASE_HOST=your-mysql-host.aivencloud.com
DATABASE_PORT=3306
DATABASE_USER=your_mysql_user
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=swachham_db
DATABASE_SSL=true

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Client
CLIENT_URL=http://localhost:3000

# Socket
SOCKET_CORS_ORIGIN=*

# ---- Rate limiting ---------------------------------------------------
# Both limiters are PER IP, PER 15 MINUTES.
#
# RATE_LIMIT_MAX      every route. Code default 600. One customer moving
#                     through categories -> items -> cart -> checkout spends
#                     30-40 requests, so this is a runaway-client guard, not
#                     a usage cap. The old value of 100 locked out ordinary
#                     sessions within minutes.
# AUTH_RATE_LIMIT_MAX sign-in and OTP routes only. Code default 10, and it
#                     should STAY tight: this one guards credentials against
#                     stuffing. Note an OTP login costs TWO requests
#                     (send-otp + verify-otp), so 10 is about five sign-ins.
#
# Development uses far higher values (see .env) so that testing several roles
# in a row, or running the smoke suites, does not lock you out.
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# NOTE: RATE_LIMIT_WINDOW_MS is NOT read by the application -- the 15-minute
# window is fixed in `middleware/rateLimiter.ts`. Kept here only because
# existing .env files carry it; changing it has no effect.
RATE_LIMIT_WINDOW_MS=900000

# ---- Reverse proxies -------------------------------------------------
# The NUMBER OF PROXY HOPS in front of this API. Blank or 0 means none.
#
# MUST be set (usually 1) behind nginx, a load balancer, or a PaaS router
# such as Render/Railway/Heroku. Without it Express reads the proxy's address
# as the client IP for every request, so the ENTIRE userbase shares one
# rate-limit bucket and the limiter locks everyone out at trivial traffic.
#
# Never set it when nothing is in front: trusting X-Forwarded-For then lets
# any caller spoof its IP and choose its own bucket.
TRUST_PROXY=0

# SMS/OTP Provider (Future)
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=

# Business calendar day for daily order-number sequences (DB runs UTC)
BUSINESS_TZ_OFFSET=+05:30

# ---------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
#
# Used to push time-critical notifications to a phone — above all the
# rider handover code, which is read out while a rider waits at the
# door. Push is an ADDITION: the durable `notifications` /
# `business_messages` rows are still written, so leaving this blank
# costs the push and nothing else.
#
# WHERE THESE COME FROM
#   Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key". That downloads a JSON file
#   containing project_id, client_email and private_key.
#
# THE PRIVATE KEY IS A REAL SECRET. It signs for the whole Firebase
# project. It is server-side only and must never reach the app — the
# app needs only google-services.json, which is not secret.
#
# QUOTING THE KEY. A .env cannot hold real newlines, so paste the key
# on ONE line, in double quotes, keeping the literal \n sequences
# exactly as they appear in the JSON. The service turns them back
# into newlines. Getting this wrong produces "Failed to parse private
# key", which reads like a bad key rather than bad quoting:
#
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
#
# Requires migration 068_push_tokens.sql.
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Meta WhatsApp Cloud API (server-side only, never shipped to the app) ---
WHATSAPP_PHONE_NUMBER_ID=1115163418357009
WHATSAPP_ACCESS_TOKEN=EAAYS3BaH89IBR0v9XD0yr7z2ZBOalPVOj5yd3RAZCwoWFKYfzNsDmhShlfTIUYwK28McEaasGDP3QMZC2kkPZBLTQcy52add6SyXPXn56ym1riOZBS9n97GJwJUD2W5dLFso8iuczDjU6JIy571q69FCtvk75h7ocfTJShUo8YABmIZA4uWWzCYfGnjfgZCWwZDZD
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFECT_TEMPLATE=defective_piece_notification

# An APPROVED Meta template for the defective-piece ADJUSTMENT message.
#
# LEAVE EMPTY UNTIL SUCH A TEMPLATE IS APPROVED. The defect template above is
# an IMAGE-header template whose body is only "Hello {{1}}, we found a
# defective or damaged piece in your laundry order {{2}}" — it has nowhere to
# put a quantity or an amount. While this is empty, the adjustment
# notification falls back to that defect template using a defect photo already
# on the order; with no photo, the send fails and says so rather than
# pretending to have delivered.
#
# The approved template's BODY must take these seven parameters, in order:
#   {{1}} customer or establishment name
#   {{2}} order number
#   {{3}} item name
#   {{4}} ordered quantity
#   {{5}} defective quantity
#   {{6}} final (billable) quantity
#   {{7}} updated order amount
#
# Run `npm run whatsapp:templates` to see what is approved on the account.
WHATSAPP_ADJUSTMENT_TEMPLATE=

# An APPROVED Meta template for the FULL defective-piece REPORT — the photo
# with the item, the service, both quantities, the date and the reason.
#
# LEAVE EMPTY UNTIL SUCH A TEMPLATE IS APPROVED. While it is empty the report
# is sent as a CAPTIONED PHOTO carrying the same detail, which Meta delivers
# inside the 24-hour customer-service window; when it refuses that, the send
# falls back to the approved defect template above (photo, name, order number).
# One message per recipient either way — a later path is only ever reached
# because the one before it was NOT delivered.
#
# The approved template must have an IMAGE header, and its BODY must take
# these ten parameters, in order:
#   {{1}}  customer or establishment name
#   {{2}}  order number
#   {{3}}  order date
#   {{4}}  business establishment name ("—" for a customer order)
#   {{5}}  item name
#   {{6}}  service type
#   {{7}}  total quantity (the pieces the order was placed for)
#   {{8}}  defective quantity
#   {{9}}  reason / details
#   {{10}} who reported it
#
# Run `npm run whatsapp:templates` to see what is approved on the account.
WHATSAPP_DEFECT_DETAIL_TEMPLATE=

# The APPROVED Meta template for the FULL defective-piece report: the photo as
# an IMAGE header and every field the Sorter entered in the body, in ONE
# message. This is the template the defect flow uses first.
#
# Category UTILITY, header IMAGE. Its BODY must take these ten parameters, in
# this order — the order is the contract, and `reportTemplateParams` in
# defect.service.ts builds them:
#   {{1}}  Order ID (printed with a leading #)
#   {{2}}  Customer / establishment name
#   {{3}}  Cloth type (the item on the line)
#   {{4}}  Defective category (the line's service — see the note in the code)
#   {{5}}  White defective quantity ("—" when no split was recorded)
#   {{6}}  Colour defective quantity ("—" when no split was recorded)
#   {{7}}  Total defective pieces
#   {{8}}  Remarks entered by the Sorter ("Not specified" when blank)
#   {{9}}  Reported by (the Sorter's name)
#   {{10}} Date & time the report was filed, in business time
#
# Defaulted rather than left blank because this template is approved on the
# account. Set it to empty to fall back to the captioned-photo path.
#
# Run `npm run whatsapp:templates` to see what is approved on the account.
WHATSAPP_DEFECT_REPORT_TEMPLATE=defective_piece_report

# An APPROVED Meta template for the ACCOUNT-READY notice — sent to a business
# when a Super Admin sets or changes its password.
#
# It must take NO body parameters: the copy is fixed and substitutes nothing.
# Have this approved at Meta with EXACTLY the wording in `ACCOUNT_READY_TEXT`
# in whatsapp.service.ts, then put the template name here.
#
# LEAVE EMPTY UNTIL IT IS APPROVED. While empty — and if an approved template
# is later refused — the same wording is attempted as a free-form message,
# which Meta delivers only to a number that has messaged the business number
# within the last 24 hours. That is enough for testing and for a business
# already in conversation, and NOT enough for one being onboarded, which is
# why this should be filled in before real onboarding.
#
# The notice carries NO username and NO password — those go by email only.
#
# Run `npm run whatsapp:templates` to see what is approved on the account.
WHATSAPP_ACCOUNT_READY_TEMPLATE=

WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# The SORTING DESK's WhatsApp number. Every defective-piece report goes here,
# and it takes precedence over the reporting Sorter's own mobile: the desk is
# a fixed line that should see every report, while whoever is on shift varies.
# The Sorter's own number is used only when this is blank.
#
# 10 digits (the country code in WHATSAPP_DEFAULT_COUNTRY_CODE is prepended)
# or full international digits. Never hardcoded in the source.
WHATSAPP_SORTER_NUMBER=

# Fallback numbers for the Manager and Super Admin copies of a defect report,
# used ONLY when no such account has a mobile number on file. The Manager who
# accepted the order and the Super Admin account are always preferred, so
# these are a last resort for a half-configured deployment rather than a
# recipient list. Unlike the sorting desk above, neither takes precedence.
WHATSAPP_MANAGER_NUMBER=
WHATSAPP_SUPER_ADMIN_NUMBER=

# --- GSTIN verification (Super Admin business registration) ---
# Server-side only. Never expose these to the mobile app.
#
# GST_PROVIDER selects the adapter in gstVerification.service.ts:
#   gstinapi    https://gstinapi.in/v1/gstin/<gstin> — key in x-api-key
#               100 free lookups per month, then credit packs from
#               Rs 0.50-0.99 per lookup. Leave GST_API_URL blank to use
#               the documented endpoint.
#   appyflow    https://appyflow.in/api/verifyGST  — key as ?key_secret=
#               Free quota of 50 lookups, then paid per request.
#   gstincheck  https://sheet.gstincheck.co.in/check/<key>/<gstin>
#               20 free test lookups; response shape is not documented.
#   generic     A GSP/aggregator that takes the key in headers. Set
#               GST_API_URL to the full endpoint; the GSTIN is sent
#               as ?gstin=. Use this to move to a licensed GSP later.
GST_PROVIDER=gstinapi
GST_API_KEY=
# Only the `generic` provider needs a second credential.
GST_API_SECRET=
# The provider endpoint. Optional for `appyflow` and `gstincheck`, which have
# documented defaults; required for `generic`.
GST_API_URL=
# Set to false only if a business may be onboarded without a verified GSTIN.
GST_VERIFICATION_REQUIRED=true

